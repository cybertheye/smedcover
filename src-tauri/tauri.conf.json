{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SmedCover",
  "version": "0.3.1",
  "identifier": "com.cyven.smedcover",
  "build": {
    "frontendDist": "../ui",
    "beforeBuildCommand": "npm run styles",
    "beforeDevCommand": "npm run styles"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SmedCover",
        "width": 1560,
        "height": 950,
        "minWidth": 1080,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 30, "y": 40 },
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
