{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SmedCover",
  "mainBinaryName": "smedcover-app",
  "version": "0.5.0",
  "identifier": "com.cyven.smedcover",
  "build": {
    "frontendDist": "../ui",
    "beforeBuildCommand": "npm run styles && npm run tools && npm run sidecar",
    "beforeDevCommand": "npm run styles && npm run tools"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "SmedCover",
        "width": 1560,
        "height": 950,
        "minWidth": 1080,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 30, "y": 40 },
        "dragDropEnabled": false,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/smedcover"],
    "windows": {
      "nsis": { "installerHooks": "windows/hooks.nsh" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERFQzIxNTdGREYzQjZFNjAKUldSZ2JqdmZmeFhDM3R5MC8xRXVWL3hOZ3BmZVU0Z0Rsc0VnMTNvSVNtN0cySFJscVJWT0tsTEcK"
    }
  }
}
